# ==============================================================================
# HypoTree Environment Configuration
# ==============================================================================
# Copy this file to .env.local:
#   cp .env.example .env.local
# Then fill in your API keys below.
# ==============================================================================

# AI backend: "auto" (default) uses the Anthropic API when ANTHROPIC_API_KEY is set,
# otherwise your logged-in Claude Code (headless, tools off). Claude Code login is for
# personal local use; use an API key for any shared or deployed instance.
AI_BACKEND=auto

# Anthropic API key (optional with AI_BACKEND=auto if Claude Code is installed and logged in)
# Get a key at: https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=

# Model for the API backend (default claude-sonnet-5-5); Claude Code uses CLAUDE_CODE_MODEL (default sonnet)
ANTHROPIC_MODEL=claude-sonnet-5-5
# CLAUDE_BIN=/path/to/claude   # only if Claude Code isn't found automatically

# Research Tree: the field-scale literature map behind the "In the field" panel and
# the per-box AI's citations (see research-tree/README.md). Cancer & cell biology instance:
RESEARCH_TREE_URL=http://127.0.0.1:8766

# Semantic Scholar API Key (Recommended for research paper search)
# Get a key at: https://www.semanticscholar.org/product/api#api-key-form
# If left blank, Semantic Scholar works with lower public rate limits.
SEMANTIC_SCHOLAR_API_KEY=your_semantic_scholar_api_key_here

