# ==============================================================================
# HypoTree Environment Configuration
# ==============================================================================
# Copy this file to .env.local:
#   cp .env.example .env.local
# Then fill in your API keys below.
# ==============================================================================

# Anthropic API Key (Required for Claude AI co-investigators & reasoning)
# Get a key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Anthropic Model to use (Defaults to claude-sonnet-5.5)
ANTHROPIC_MODEL=claude-sonnet-5.5

# Semantic Scholar API Key (Recommended for research paper search)
# Get a key at: https://www.semanticscholar.org/product/api#api-key-form
# If left blank, Semantic Scholar works with lower public rate limits.
SEMANTIC_SCHOLAR_API_KEY=your_semantic_scholar_api_key_here

# Firebase (Required for "Sign in with Google")
# Web app config: Firebase console → Project settings → General → Your apps.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Admin SDK (server only, keep secret): Project settings → Service accounts → Generate new private key.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the key on one line with \n for newlines, wrapped in double quotes.
FIREBASE_PRIVATE_KEY=
