# ==============================================================================
# Branchly environment configuration
# ==============================================================================
# Copy this file to .env.local (git-ignored) and fill in the values:
#   cp .env.example .env.local
# ==============================================================================

# ── AI ────────────────────────────────────────────────────────────────────────
# "auto" (default) uses the Anthropic API when ANTHROPIC_API_KEY is set, otherwise
# your logged-in Claude Code (headless, tools off). Claude Code login is for personal
# local use; use an API key for any shared or deployed instance.
AI_BACKEND=auto
# Get a key at: https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=
# Model for the API backend (default claude-sonnet-5-5); Claude Code uses CLAUDE_CODE_MODEL (default sonnet)
ANTHROPIC_MODEL=claude-sonnet-5-5
# CLAUDE_BIN=/path/to/claude   # only if Claude Code isn't found automatically

# ── Literature ────────────────────────────────────────────────────────────────
# The field map (Research Tree, see research-tree/README.md). Cancer cell death instance:
RESEARCH_TREE_URL=http://127.0.0.1:8766
# Semantic Scholar (optional): a key gives 1 request/second; without one the no-key
# bulk search is used. Get one at https://www.semanticscholar.org/product/api#api-key-form
SEMANTIC_SCHOLAR_API_KEY=

# ── Sign-in, teams and shared trees (Firebase project branchly-2478f) ─────────
# Firebase console > Project settings > General > Your apps (web app config):
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=branchly-2478f.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=branchly-2478f
NEXT_PUBLIC_FIREBASE_APP_ID=
# Project settings > Service accounts > Generate new private key (SECRET, never commit):
FIREBASE_PROJECT_ID=branchly-2478f
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
